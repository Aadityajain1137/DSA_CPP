class Solution {
public:
    int helper(string &s ,char ch1 , char ch2){
        int n = s.length();
        unordered_map<int,int> diff;
        int count1=0;
        int count2= 0;
        int maxL =0;
        diff[0] = -1;
        for(int i=0;i<n;i++){
            if(s[i] != ch1 && s[i] !=ch2 ){
                diff.clear();
                diff[0] = i;
                count1 = 0;
                count2 = 0;
                continue;
            }
            if(s[i] == ch1){
                count1++;
            }
            if(s[i] == ch2){
                count2++;
            }
            if(count1 == count2){
                maxL = max(maxL, count1+count2);
            }
            int di = count1 - count2;
            if(diff.count(di)){
                maxL = max(maxL , i-diff[di]);
            }
            else{
                diff[di] = i;
            }
        }
        return maxL;
    }
    int longestBalanced(string s) {
        int n= s.length();
        int count = 1;
        int maxL = 1;
        for(int i=1;i<n;i++){
            if(s[i-1] == s[i]){
                count++;
            }
            else{
                maxL = max(maxL , count);
                 count = 1;
            }
        }
        maxL = max(maxL , count);

        maxL = max(maxL,helper(s , 'a' , 'b'));
        maxL = max(maxL,helper(s , 'a' , 'c'));
        maxL = max(maxL,helper(s , 'b', 'c'));
        
        int countA = 0;
        int countB = 0;
        int countC = 0;
        unordered_map<string , int> diff;
        diff["0_0"] = -1;
        for(int i=0;i<n;i++){
            if(s[i]=='a') countA++;
            if(s[i] == 'b') countB++;
            if(s[i] == 'c') countC++;
            if(countA == countB && countA == countC){
                maxL = max(maxL , countA + countB + countC);
            }
            int diffAB = countA - countB;
            int diffAC = countA - countC;
            string key = to_string(diffAB) + '_' + to_string(diffAC);
            if(diff.count(key)){
                maxL = max(maxL , i-diff[key]);
            }
            else{
                diff[key] = i;
            }
        }
        return maxL;
    }
};
