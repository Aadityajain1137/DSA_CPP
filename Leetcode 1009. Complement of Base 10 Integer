class Solution {
public:
    int bitwiseComplement(int n) {
        if(n == 0) return 1;
        string ans  = "";
        while(n>0){
            ans.push_back( (n & 1) + '0');
            n = n>>1;
        }
        reverse(ans.begin(),ans.end());
        for(auto &i : ans){
            i = (i=='0') ? '1' : '0';
        }
        int solve = 0;
        for(auto i : ans){
            solve = solve << 1;
            solve += (i-'0') & 1;
        }
        return solve;
    }
};
