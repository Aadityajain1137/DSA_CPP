    int solve(vector<int>& nums1, vector<int>&nums2,int i , int j,vector<vector<int>>&dp){
        if(i<0 || j < 0){
            return INT_MIN;
        }
        if(dp[i][j]!=INT_MIN){
            return dp[i][j];
        }
        int include = nums1[i]*nums2[j];
        int prev = solve(nums1,nums2,i-1,j-1,dp);
        if(prev!=INT_MIN){
            include += max(0,prev);
        }
        int exclude1 = solve(nums1,nums2,i-1,j,dp);
        int exclude2 = solve(nums1,nums2,i,j-1,dp);
        dp[i][j] =   max(include, max(exclude1, exclude2));
        return dp[i][j];
    }

    int solve(vector<int>&nums1 , vector<int> &nums2){
        int n = nums1.size();
        int m = nums2.size();
        vector<vector<int>> dp(n,vector<int>(m,INT_MIN));
        for(int i=0;i<n;i++){
            for(int j=0;j<m;j++){
                int include = nums1[i]*nums2[j];
                if(i>0 && j>0 && dp[i-1][j-1]!=INT_MIN){
                    include+=max(0,dp[i-1][j-1]);
                }
                int exclude1 = i>0 ? dp[i-1][j]:INT_MIN;
                int exclude2 = j>0 ? dp[i][j-1]:INT_MIN;

                dp[i][j] = max(include , max(exclude1,exclude2));
            }
        }
        return dp[n-1][m-1];
    }
    int maxDotProduct(vector<int>& nums1, vector<int>& nums2) {
        // return solve(nums1, nums2,nums1.size()-1,nums2.size()-1);
        vector<vector<int>> dp(nums1.size(),(vector<int>(nums2.size(),INT_MIN)));
        return solve(nums1, nums2 , nums1.size()-1,nums2.size()-1,dp);
        // return solve(nums1,nums2);
    }
