class Solution {
public:
    int nthUglyNumber(int n) {
        long long num = 1;
        unordered_set<long> st;
        priority_queue<long, vector<long>, greater<long>> pq;
        pq.push(1);
        st.insert(1);
        for (int i = 0; i < n; i++) {
            num = pq.top();
            pq.pop();
            if (st.find(num * 2) == st.end()) {
                pq.push(num * 2);
                st.insert(num * 2);
            }
            if (st.find(num * 3) == st.end()) {
                pq.push(num * 3);
                st.insert(num * 3);
            }
            if (st.find(num * 5) == st.end()) {
                pq.push(num * 5);
                st.insert(num * 5);
            }
        }
        return num;
    }
};
