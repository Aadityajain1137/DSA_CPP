class Solution {
public:
    bool dfs(vector<vector<char>>& board ,int r ,int c , int idx,string &word){
        if(idx ==word.size()){
            return true;
        }
        if(r<0 || r>=board.size() || c<0 || c>= board[0].size() || word[idx] != board[r][c]){
            return false;
        }
        char temp = board[r][c];
        board[r][c] = '#';
        bool found = {
            dfs(board , r+1,c,idx+1,word)||
            dfs(board , r , c+1 , idx+1 , word)||
            dfs(board , r-1 , c , idx+1 , word) ||
            dfs(board , r , c-1 , idx+1 , word)
        };
        board[r][c] = temp; 
        return found;
    }
    bool exist(vector<vector<char>>& board, string word) {
       int row = board.size();
       int col = board[0].size();
       for(int i=0;i<row;i++){
            for(int j=0;j<col;j++){
                if(dfs(board,i,j,0,word)){
                    return true;
                }
            }
       }
       return false;

    }
};
