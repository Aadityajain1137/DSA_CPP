class Solution {
public:
    int solve(vector<int>& prices){
        int profit = 0;
        int minPrice = INT_MAX;
        int n = prices.size();
        for(int i=0;i<n;i++){
            minPrice = min(minPrice , prices[i]);
            profit = max(profit , prices[i] - minPrice);
        }
        return profit;
    }
    int maxProfit(vector<int>& prices) {
        return solve(prices);
    }
};
