class Solution {
public:
    int numRabbits(vector<int>& answers) {
        unordered_map<int, int> mp;
        for (int x : answers) {
            mp[x]++;
        }
        int ans = 0;
        for (auto& p : mp) {
            int v = p.first;
            int fre = p.second;
            int groupSize = v + 1;
            int groups = (fre + groupSize - 1) / groupSize;
            ans+= groups*groupSize;
        }
        return ans;
    }
};
