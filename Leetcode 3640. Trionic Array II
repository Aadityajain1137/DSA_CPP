class Solution {
public:
    long long maxSumTrionic(vector<int>& nums) {
        int n = nums.size();
        vector<long long> inEnd(n, -1e18);
        vector<long long> inStart(n,  -1e18);
        long long ans =  -1e18;
        for (int i = 1; i < n; i++) {
            inEnd[i] = nums[i];
            if (i && nums[i] > nums[i - 1]) {
                inEnd[i] = max((long long)nums[i - 1] + nums[i],
                               inEnd[i - 1] + inEnd[i]);
            }
        }
        for (int i = n - 1; i >= 0; i--) {
            inStart[i] = nums[i];
            if (i < n - 1 && nums[i] < nums[i + 1]) {
                inStart[i] = max((long long)nums[i] + nums[i + 1],
                                 inStart[i] + inStart[i + 1]);
            }
        }
        for(int i=1;i<n-1;i++){
            if(nums[i]>nums[i-1] && nums[i]>nums[i+1]){
                int j = i;
                long long sum =0;
                while(j<n-1 && nums[j]>nums[j+1]){
                    sum+=nums[j];
                    j++;
                }
                if(j<n-1 && nums[j]<nums[j+1]){
                    ans = max(ans , inEnd[i]-nums[i]+sum + inStart[j]);
                }
                i =j;
            }
        }
        return ans;
    }
};
