class Solution {
  public:
    int minMeetingRooms(vector<int> &start, vector<int> &end) {
        int ans =0;
        int rooms = 0;
        int i=0;
        int j =0;
        sort(start.begin(),start.end());
        sort(end.begin(),end.end());
        while(i<start.size() && j<end.size()){
            if(start[i]<end[j]){
                i++;
                rooms++;
                ans = max(rooms , ans);
            }
            else if(start[i]>end[j]){
                j++;
                rooms--;
                ans = max(rooms , ans);
            }
            else{
                i++;
                j++;
            }
        }
        return ans;
    }
};
