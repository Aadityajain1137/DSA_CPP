class Solution {
public:
    vector<int> answerQueries(vector<int>& nums, vector<int>& queries) {
        sort(nums.begin(),nums.end());
        int n = nums.size();
        for(int i=1;i<n;i++){
            nums[i] = nums[i-1] + nums[i];
        }
        vector<int> ans;
       for(int query : queries){
        int start = 0;
        int end = n-1;
        int res = 0;
        while(start<=end){
            int mid = start + (end-start)/2;
            if(query >= nums[mid]){
                res = mid+1;
                start = mid+1;
            }
            else {
                end = mid-1;
            }
        }
        ans.push_back(res);
       }
       return ans;
    }
};
