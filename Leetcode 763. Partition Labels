class Solution {
public:
    vector<int> partitionLabels(string s) {
        unordered_map<char ,int> mp;
        int s1 = 0;
        int e=0;
        for(int i=0;i<s.length();i++){
            mp[s[i]] = i;
        }
        vector<int> ans;
        int farthest = 0;
        for(int i=0;i<s.size();i++){
            farthest = max(farthest , mp[s[i]]);
            if(e == farthest){
                int a = e-s1+1;
                ans.push_back(a);
                a = 0;
                s1 = e+1;
            }
            e++;
        }
        return ans;
    }
};
