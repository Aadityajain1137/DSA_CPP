class Solution {
public:
    int scheduleCourse(vector<vector<int>>& courses) {
        priority_queue<int> pq;
        int total = 0;
        sort(courses.begin(),courses.end() ,[](vector<int>&a , vector<int> &b){
            return a[1]<b[1];
        });
        for(auto &c : courses){
            int duration = c[0];
            int cost = c[1];
            pq.push(duration);
            total+=duration;
            if(total>cost){
                total-=pq.top();
                pq.pop();
            }
        }
        return pq.size();
    }
};
