class Solution {
public:
    int solve(int n, vector<int> &heights){
        if(n==0){
            return 0;
        }
        vector<int> ans;
        ans.push_back(heights[0]);
        for(int i=1;i<n;i++){
            if(heights[i]>ans.back()){
                ans.push_back(heights[i]);
            }else{
                int index = lower_bound(ans.begin(), ans.end(), heights[i]) - ans.begin();
                ans[index] = heights[i];
        }}
        return ans.size();
    }
    int maxEnvelopes(vector<vector<int>>& envelopes) {
         sort(envelopes.begin(), envelopes.end(), [](auto &a, auto &b) {
            if (a[0] == b[0])
                return a[1] > b[1];
            return a[0] < b[0];
        });
        vector<int> heights;
        for(auto &e : envelopes){
            heights.push_back(e[1]);
        }
        return solve(heights.size(),heights);
    }
};
