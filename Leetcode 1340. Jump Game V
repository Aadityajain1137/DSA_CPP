class Solution {
public:
    int solve(vector<int>& arr , int d , vector<int> &dp , int i){
        if(dp[i]!=-1){
            return dp[i];
        }
        int n = arr.size();
        int ans = 1;
        for(int j = i+1; j<=min(n-1 , i+d) ; j++){
            if(arr[j]>=arr[i]){
                break;
            }
            ans = max(ans ,1 + solve( arr , d , dp , j));

        }
        for(int j = i-1;j>=max(0 , i-d);j--){
            if(arr[j]>=arr[i]){
                break;
            }
            ans = max(ans,1 + solve(arr , d , dp , j));
        }
        return dp[i] = ans;
        
    }
    int maxJumps(vector<int>& arr, int d) {
        int n = arr.size();
        vector<int> dp(n , -1);
        int result = 1;
        for(int i =0;i<n;i++){
            result = max(result , solve(arr , d , dp , i));
        }
        return result;
    }
};
