class Solution {
public:
    void dfs(int i, int j, vector<vector<int>>& v,
             vector<vector<int>>& heights) {
        v[i][j] = 1;
        int n = heights.size();
        int m = heights[0].size();
        int drow[] = {-1, 1, 0, 0};
        int dcol[] = {0, 0, 1, -1};
        for (int k = 0; k < 4; k++) {
            int ni = i + drow[k];
            int nj = j + dcol[k];
            if (ni >= 0 && ni < n && nj >= 0 && nj < m &&
                heights[i][j] <= heights[ni][nj] && !v[ni][nj]) {
                dfs(ni, nj, v, heights);
            }
        }
    }
    vector<vector<int>> pacificAtlantic(vector<vector<int>>& heights) {
        int n = heights.size();
        int m = heights[0].size();
        vector<vector<int>> v(n, vector<int>(m, 0));
        vector<vector<int>> a(n, vector<int>(m, 0));
        for (int i = 0; i < n; i++) {
            dfs(i, 0, v, heights);
        }
        for (int i = 0; i < m; i++) {
            dfs(0, i, v, heights);
        }

        for (int i = 0; i < n; i++) {
            dfs(i, m - 1, a, heights);
        }
        for (int i = 0; i < m; i++) {
            dfs(n - 1, i, a, heights);
        }
        vector<vector<int>> ans;
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < m; j++) {
                if (v[i][j] && a[i][j]) {
                    ans.push_back({i, j});
                }
            }
        }
        return ans;
    }
};
