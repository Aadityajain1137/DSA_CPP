class Solution {
public:
    double solve(int p , int i , int j,vector<vector<double>> &dp){
        if(i<0 || j<0 || i <j) return 0.0;
        if(i==0 && j==0) return p;
        if(dp[i][j] != -1.0){
            return dp[i][j];
        }
        double leftup = (solve(p , i-1,j-1,dp)-1)/2.0;
        double rightup = (solve(p , i-1 , j,dp)-1)/2.0;
        if(leftup<0) leftup = 0.0;
        if(rightup<0) rightup = 0.0;
        return dp[i][j] = leftup + rightup;
    }
    double champagneTower(int poured, int query_row, int query_glass) {
        vector<vector<double>> dp(101,(vector<double>(101,-1.0)));
        return min(1.0 , solve(poured , query_row , query_glass,dp));
    }
};
