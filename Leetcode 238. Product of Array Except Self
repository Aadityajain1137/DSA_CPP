class Solution {
public:
    vector<int> productExceptSelf(vector<int>& nums) {
        // vector<int> result;
        // for(int i =0;i<nums.size();i++){
        //     int ans = 1;
        //     for(int j=0;j<nums.size();j++){
        //         if(j!=i){
        //             ans*=nums[j];
        //         }
        //     }
        //     result.push_back(ans);
        // }
        // return result;


        int n = nums.size();
        vector<int> result(n, 1);
        int prefix = 1;
        for(int i =0;i<n;i++){
            result[i]=prefix;
            prefix *=nums[i];
        }
        int suffix = 1;
        for(int i = n-1;i>=0;i--){
            result[i]*=suffix;
            suffix*=nums[i];
        }
        return result;
    }
};
