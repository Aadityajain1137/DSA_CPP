class Solution {
public:
    void have(int i,int j ,vector<vector<int>>&visited , queue<pair<int,int>>&q,vector<vector<int>>& grid){
        int n = grid.size();
        int m = grid[0].size();
        if(i<0 || i>=n || j<0 || j>=m || visited[i][j] || grid[i][j] == 0) return;
        visited[i][j] = 1;
        q.push({i,j});
        int drow[] = {1, -1 ,0 ,0};
        int dcol[] = {0 , 0 , -1 , 1};
        for(int k=0;k<4;k++){
            int ni = i + drow[k];
            int nj = j + dcol[k];
            have(ni , nj, visited , q , grid);
        }
    }
    int shortestBridge(vector<vector<int>>& grid) {
      int n = grid.size();
      int m = grid[0].size();
      vector<vector<int>>visited(n , vector<int>(m,0));
      queue<pair<int,int>> q;
      bool found = false;
      for(int i=0;i<n && !found;i++){
        for(int j=0;j<m && !found;j++){
            if(grid[i][j] == 1) {
                    have(i, j, visited, q, grid);
                    found = true;
                }
        }
      }  
      int steps = 0;
      int drow[] = {1, -1 ,0 ,0};
        int dcol[] = {0 , 0 , -1 , 1};
      while(!q.empty()){
        int sz = q.size();
        while(sz--){
            int r = q.front().first;
            int c = q.front().second;
            q.pop();
            for(int k=0;k<4;k++){
                int ni = r + drow[k];
                int nj  = c + dcol[k];
                if(ni>=0 && ni<n && nj>=0 && nj<m && !visited[ni][nj]){
                    if(grid[ni][nj] == 1) return steps;
                    q.push({ni , nj});
                    visited[ni][nj] = 1;
                }
            }
        }
        steps++;
      }
      return -1;
    }
};
