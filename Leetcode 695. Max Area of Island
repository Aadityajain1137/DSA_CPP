class Solution {
public:
    bool isValid(int i, int j, vector<vector<int>>& grid, int n, int m) {
        if (i < n && i >= 0 && j >= 0 && j < m && grid[i][j] == 1) {
            return true;
        } else {
            return false;
        }
    }
    void dfs(vector<vector<int>>& grid, int i, int j, int n, int m, int &a) {
        a++;
        grid[i][j] = 0;
        if (isValid(i + 1, j, grid, n, m)) {
            dfs(grid, i + 1, j, n, m, a);
        }
        if (isValid(i - 1, j, grid, n, m)) {
            dfs(grid, i - 1, j, n, m, a);
        }
        if (isValid(i, j + 1, grid, n, m)) {
            dfs(grid, i, j + 1, n, m, a);
        }
        if (isValid(i, j - 1, grid, n, m)) {
            dfs(grid, i, j - 1, n, m, a);
        }
    }
    int maxAreaOfIsland(vector<vector<int>>& grid) {
        int n = grid.size();
        int m = grid[0].size();
        int area = 0;
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < m; j++) {
                if(grid[i][j]==1){
                    int a = 0;
                dfs(grid, i, j, n, m, a); 
                area = max(area, a);
                }
            }
        }
        return area;
    }
};
