class Solution {
public:
    int minimumCost(vector<int>& nums) {
       int ans = nums[0];
       if(nums.size()<3) return ans;
       sort(nums.begin()+1, nums.end());
       ans+= nums[1] + nums[2];
       return ans;
    }
