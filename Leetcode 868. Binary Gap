class Solution {
public:
    int binaryGap(int n) {
        string s = "";
        while (n > 0) {
            s = char('0' + (n & 1)) + s;
            n >>= 1;
        }

        int ans = 0, prev = -1;
        for (int i = 0; i < s.size(); i++) {
            if (s[i] == '1') {
                if (prev != -1)
                    ans = max(ans, i - prev);
                prev = i;
            }
        }
        return ans;
    }
};
