/**
 * Definition for a binary tree node.
 * struct TreeNode {
 *     int val;
 *     TreeNode *left;
 *     TreeNode *right;
 *     TreeNode() : val(0), left(nullptr), right(nullptr) {}
 *     TreeNode(int x) : val(x), left(nullptr), right(nullptr) {}
 *     TreeNode(int x, TreeNode *left, TreeNode *right) : val(x), left(left), right(right) {}
 * };
 */
class Solution {
public:
    long long total = 0;
    int mod = 1e9+7;
    void TotalSum(TreeNode*root){
        if(root == NULL) return;
        TotalSum(root->left);
        TotalSum(root->right);
        total+=root->val;
    }

    long long solve(TreeNode* root, long long &maxProduct){
        if(root == NULL) return 0;
        long long left = solve(root->left, maxProduct);
        long long right = solve(root->right , maxProduct);
        long long subtreeSum = root->val + left + right;
        long long ans =subtreeSum*(total-subtreeSum);
        maxProduct = max(maxProduct , ans);
        return subtreeSum;;
    }
    int maxProduct(TreeNode* root) {
        TotalSum(root);
        long long maxProduct = 1;
        solve(root, maxProduct);
        return (maxProduct%mod);
    }
};
