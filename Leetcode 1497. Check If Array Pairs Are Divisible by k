class Solution {
public:
    bool canArrange(vector<int>& arr, int k) {
        unordered_map<int,int> mp;
        for(int num : arr){
            int rem = ((num%k)+k)%k;
            mp[rem]++;
        }
        if(mp.find(0)!=mp.end()){
            if(mp[0]%2 != 0){
                return false;
            }
        mp.erase(0);
        }
        for(auto it  : mp){
            int val = it.first;
            int rem = k - val;
            if(mp.find(rem) == mp.end()) return false;
            if(mp[val] != mp[rem]) return false;
        }
        return true;
    }
};
