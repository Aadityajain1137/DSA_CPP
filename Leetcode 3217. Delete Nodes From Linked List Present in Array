        unordered_set<int> st(nums.begin(), nums.end());
         ListNode* dummy = new ListNode(0);
        dummy->next = head;
        ListNode* prev = dummy;
        while(head !=NULL){
            if(st.count(head->val)){
                prev->next = head->next;
            }
            else{
                prev = head;
            }
            head = head->next;
        }
        return dummy->next;
    }
