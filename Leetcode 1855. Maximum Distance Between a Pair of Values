class Solution {
public:
    int maxDistance(vector<int>& nums1, vector<int>& nums2) {
        int n = nums1.size();
        int m = nums2.size();
        int dis = 0;
        for(int i=0;i<n;i++){
            int l = i;
            int ans = -1;
            int r= m-1;
            while(l<=r){
                int mid = l+(r-l)/2;
                if(nums2[mid] >= nums1[i]){
                    ans = mid;
                    l = mid+1;
                }
                else{
                    r= mid-1;
                }
            }
            if(ans!=-1){
                dis = max(dis , ans - i);
            }
        }
        return dis;
    }
};
