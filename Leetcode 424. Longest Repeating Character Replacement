class Solution {
public:
    int characterReplacement(string s, int k) {
        int l =0;
        int n = s.length();
        int r = 0;
        int maxLen = 0;
        int maxFeq= 0;
        unordered_map<char,int> mp;
        while(r<n){
            mp[s[r]]++;
            maxFeq = max(maxFeq,mp[s[r]]);
            while((r-l+1)-maxFeq>k){
                mp[s[l]]--;
                l = l+1;
            }
                maxLen = max(maxLen,r-l+1);
                r++;
        }
        return maxLen;
    }
};
