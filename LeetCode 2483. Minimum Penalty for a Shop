class Solution {
public:
    int bestClosingTime(string customers) {
        int n = customers.length();
        vector<int> pre(n+1,0);
        vector<int> suf(n+1,0);
        int no = 0;
        int yo = 0;
        for(int i = 0;i<n;i++){
            no+=(customers[i] == 'N');
            pre[i+1] = no;
        }
        for(int i=n-1;i>=0;i--){
            yo+=(customers[i] == 'Y');
            suf[i] = yo;
        }
        int minIdx= 0;
        int mini  = INT_MAX;
        for(int i=0;i<=n;i++){
            int penalty = pre[i] + suf[i];
            if(penalty<mini){
                mini = penalty;
                minIdx = i;
            }
        }
        return minIdx;
    }
};
