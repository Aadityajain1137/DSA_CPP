class Solution {
public:
    vector<Node*> regi;
    void dfs(Node* node , Node* clone){
        for(auto neig : node->neighbors){
            if(!regi[neig->val]){
                Node* newNode = new Node(neig->val);
                regi[newNode->val] = newNode;
                clone->neighbors.push_back(newNode);
                dfs(neig , newNode);
            }else{
                clone->neighbors.push_back(regi[neig->val]);
            }
        }
    }
    Node* cloneGraph(Node* node) {
        if(node == NULL) return NULL;
        Node* clone = new Node(node->val);
        regi.resize(110 , NULL);
        regi[clone->val] = clone;
        dfs(node , clone);
        return clone;
    }
};
