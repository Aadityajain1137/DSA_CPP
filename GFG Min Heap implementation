class minHeap {
  private:
    int idx;
    int arr[1000];

  public:
    
    minHeap(){
        idx = 1;
    }
    void push(int x) {
        arr[idx] = x;
        int i = idx;
        idx++;
        while(i!=1){
            int parent = i/2;
            if(arr[i]<arr[parent]){
                swap(arr[i],arr[parent]);
                i = parent;
            }
            else break;
        }
    }

    void pop() {
        arr[1] = arr[idx-1];
        int i =1;
        idx--;
        while(true){
            int left = i*2;
            int right = i*2+1;
            int smallest = i;
            if(left<idx && arr[left]<arr[smallest]){
                smallest = left;
            }
            if(right<idx && arr[right]<arr[smallest]){
                smallest = right;
            }
            if(smallest!=i){
                swap(arr[smallest] , arr[i]);
                i = smallest;
            }
            else break;
        }
    }

    int peek() {
        if(idx == 1) return -1;
        return arr[1];
    }

    int size() {
        return idx-1;
    }
};
