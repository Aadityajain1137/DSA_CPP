class Solution {
public:
    int solve(int i,int n , int prev1, int prev2 , int prev3, int mod ,vector<vector<vector<vector<int>>>> &dp){
        if(i==n){
            return 1;
        }
        if(dp[i][prev1][prev2][prev3]!=-1){
            return dp[i][prev1][prev2][prev3];
        }
        long long ans = 0;
        for(int c1 = 1;c1<=3;c1++){
            if(c1==prev1) continue;
            for(int c2=1;c2<=3;c2++){
                if(c2==prev2 || c2==c1) continue;
                for(int c3=1;c3<=3;c3++){
                    if(c3==prev3 || c3 == c2) continue;
                    ans = (ans+solve(i+1,n,c1,c2,c3,mod,dp))%mod;
                }
            }
        }
        return dp[i][prev1][prev2][prev3] =  ans;
    }

    int solve(int n){
        const int mod = 1e9+7;
        long long aba = 6;
        long long abc = 6;
        for(int i=2;i<=n;i++){
            long long newaba = (aba*3 + abc*2)%mod;
            long long newabc = (aba*2 + abc*2)%mod;
            aba = newaba;
            abc = newabc;
        }
        return (aba+abc)%mod;
    }
    int numOfWays(int n) {
        // int mod = 1e9+7;
        // vector<vector<vector<vector<int>>>>dp(n+1,vector<vector<vector<int>>>(4,vector<vector<int>>(4,vector<int>(4,-1))));
        // return solve(0,n,0,0,0,mod,dp);
        return solve(n);

    }
};
