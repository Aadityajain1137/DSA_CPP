class Solution {
public:
    bool closeStrings(string word1, string word2) {
        if(word1.length()!=word2.length()) return false;
        unordered_map<char,int> mp1;
        for(char s : word1){
            mp1[s]++;
        }
        unordered_map<char,int> mp2;
        for(char s : word2){
            mp2[s]++;
        }
        for(auto it : mp1){
            if(mp2.find(it.first) == mp2.end()){
                return false;
            }
        }
        vector<int> freq1;
        vector<int> freq2;
        for(auto it : mp1) freq1.push_back(it.second);
        for(auto it : mp2) freq2.push_back(it.second);
        sort(freq1.begin(),freq1.end());
        sort(freq2.begin(),freq2.end());
        return freq1 == freq2;
    }
};
