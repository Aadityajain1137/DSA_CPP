class Solution {
public:
    vector<vector<int>> ans;
    void solve(vector<int>& candidates, int target, int sum, vector<int>& sol,
               int index) {
        if (sum == target) {
            ans.push_back(sol);
        }
        if(sum> target) return;
        for(int i=index;i<candidates.size();i++){
            sol.push_back(candidates[i]);
            solve(candidates , target , sum + candidates[i] , sol , i);
            sol.pop_back();
        }
    }
    vector<vector<int>> combinationSum(vector<int>& candidates, int target) {
        vector<int> sol;
        solve(candidates, target, 0, sol, 0);
        return ans;
    }
};
