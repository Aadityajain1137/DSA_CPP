    void solve2(vector<vector<int>>& matrix, vector<vector<int>>& dp) {
        int n = matrix.size();
        for (int j = 0; j < n; j++) {
            dp[0][j] = matrix[0][j];
        }
        for (int i = 1; i < n; i++) {
            for (int j = 0; j < n; j++) {
                int up = dp[i - 1][j];
                int left = (j>0)?dp[i-1][j-1]:1e9;
                int right = (j<n-1)?dp[i-1][j+1]:1e9;
                dp[i][j] = matrix[i][j]+min({up,left , right});
            }
        }
    }

    int minFallingPathSum(vector<vector<int>>& matrix) {
        // int n = matrix.size();
        // vector<vector<int>> dp(n, vector<int>(n, -1));
        // int ans = INT_MAX;

        // for (int j = 0; j < n; j++) {
        //     ans = min(ans, solve(matrix, 0, j, dp));
        // }

        // return ans;

        int n= matrix.size();
        vector<vector<int>> dp(n,vector<int>(n,0));
        solve2(matrix,dp);
        int ans = INT_MAX;
        for(int j =0;j<n;j++){
            ans = min(ans, dp[n-1][j]);
        }
        return ans;
    }
