class DetectSquares {
public:
    unordered_map<int , unordered_map<int,int>> cnt;
    DetectSquares() {
        
    }
    
    void add(vector<int> point) {
        int x = point[0] , y = point[1];
        cnt[x][y]++;
    }
    
    int count(vector<int> point) {
        int x = point[0] ,  y = point[1];
        int result = 0;
        if(!cnt.count(x)) return 0;
        for(auto &[ny , f] : cnt[x]){
            int d = ny-y;
            if(d == 0) continue;
            result += f * cnt[x+d][y] * cnt[x+d][ny];
            result += f * cnt[x-d][y] * cnt[x-d][ny];
        }
        return result;
    }
};

