class Solution {
public:
    int eraseOverlapIntervals(vector<vector<int>>& intervals) {
        sort(intervals.begin(),intervals.end());
        int n = intervals.size(); 
        int count =0;
        int i=0;
        while(i<n-1){
            if(intervals[i][1]>intervals[i+1][0]){
                count++;
                if(intervals[i][1]<= intervals[i+1][1]){
                    intervals[i+1] = intervals[i];
                }
            }
            i++;
        }
        return count;
    }
};
