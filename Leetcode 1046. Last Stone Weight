class Solution {
public:
    int lastStoneWeight(vector<int>& stones) {
        int n = stones.size();
        priority_queue<int> pq;
        for(int ele : stones){
            pq.push(ele);
        }
        while(pq.size()>1){
            int first = pq.top();
            pq.pop();
            int second = pq.top();
            pq.pop();
            if(first != second){
                 int newEle = first - second;
                pq.push(newEle);
            }
        }
        if(pq.size()==1){
            return pq.top();
        }
        return 0;
    }
};
