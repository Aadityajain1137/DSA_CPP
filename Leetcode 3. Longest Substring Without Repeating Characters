class Solution {
public:
    int lengthOfLongestSubstring(string s) {
        vector<int> hash(256,-1);
        int l = 0;
        int r = 0;
        int maxLen = 0;
        int n = s.length();
        while(r<n){
            int len = 0;
            if(hash[s[r]]!=-1){
                if(hash[s[r]]>=l){
                    l = hash[s[r]] + 1;
                }
            }
            len = r-l+1;
            maxLen = max(len,maxLen);
            hash[s[r]]=r;
            r++;
        }
        return maxLen;
    }
};
