class Solution {
public:
    int findLHS(vector<int>& nums) {
        sort(nums.begin() , nums.end());
        int l = 0;
        int r = 1;
        int n = nums.size();
        int len = 0;
        while(r<n){
             while (nums[r] - nums[l] > 1) {
                l++;
            }
            if(nums[r] - nums[l] == 1){
                len = max(len , r - l+1);
            }
            r++;
        }
        return len;
    }
};
