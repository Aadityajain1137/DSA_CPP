class Solution {
public:
    int numberOfSubmatrices(vector<vector<char>>& grid) {
        int n = grid.size();
        int m = grid[0].size();
        vector<vector<int>> x(n,vector<int>(m,0));
        vector<vector<int>> y(n,vector<int>(m,0));
        int count = 0;
        for(int i=0;i<n;i++){
            for(int j=0;j<m;j++){
                x[i][j] = (grid[i][j] == 'X');
                y[i][j] = (grid[i][j] == 'Y');
                if(i>0){
                    x[i][j]+=x[i-1][j];
                    y[i][j]+=y[i-1][j];
                }
                if(j>0){
                    x[i][j] += x[i][j-1];
                    y[i][j] += y[i][j-1];
                }
                if(i>0 && j>0){
                    x[i][j]-= x[i-1][j-1];
                    y[i][j]-=y[i-1][j-1];
                }
                if(x[i][j] == y[i][j] && x[i][j]>0){
                    count++;
                }
            }
        }
        return count;
    }
};
