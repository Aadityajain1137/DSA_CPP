class Solution {
public:
    int n, m;

    int solve(int i, int j, int k,
              vector<vector<int>>& grid,
              vector<vector<vector<int>>>& dp) {

        if (i >= n || j >= m) return INT_MIN;

        int cost = (grid[i][j] == 0 ? 0 : 1);

        if (k < cost) return INT_MIN;

        if (i == n - 1 && j == m - 1) {
            return grid[i][j];
        }

        if (dp[i][j][k] != -1) return dp[i][j][k];

        int newK = k - cost;

        int right = solve(i, j + 1, newK, grid, dp);
        int down  = solve(i + 1, j, newK, grid, dp);

        int best = max(right, down);

        if (best == INT_MIN) return dp[i][j][k] = INT_MIN;

        return dp[i][j][k] = grid[i][j] + best;
    }

    int maxPathScore(vector<vector<int>>& grid, int k) {
        n = grid.size();
        m = grid[0].size();

        vector<vector<vector<int>>> dp(
            n, vector<vector<int>>(m, vector<int>(k + 1, -1))
        );

        int ans = solve(0, 0, k, grid, dp);

        return (ans < 0 ? -1 : ans);
    }
};
