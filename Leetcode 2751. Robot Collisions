class Solution {
public:
    vector<int> survivedRobotsHealths(vector<int>& positions,
                                      vector<int>& healths, string directions) {
        
        int n = positions.size();
        
        vector<pair<int, pair<int, pair<char,int>>>> robots;
        
        for (int i = 0; i < n; i++) {
            robots.push_back({positions[i], {healths[i], {directions[i], i}}});
        }
        
        sort(robots.begin(), robots.end());
        
        stack<pair<int, pair<char,int>>> st;

        for (auto& robot : robots) {
            int h = robot.second.first;
            char d = robot.second.second.first;
            int idx = robot.second.second.second;

            if (d == 'R') {
                st.push({h, {d, idx}});
            } 
            else {
                while (!st.empty() && st.top().second.first == 'R') {
                    
                    if (st.top().first < h) {
                        st.pop();
                        h--;
                    } 
                    else if (st.top().first == h) {
                        st.pop();
                        h = 0;
                        break;
                    } 
                    else {
                        st.top().first--;
                        h = 0;
                        break;
                    }
                }
                
                if (h > 0) {
                    st.push({h, {d, idx}});
                }
            }
        }

        vector<pair<int,int>> temp;
        
        while (!st.empty()) {
            temp.push_back({st.top().second.second, st.top().first});
            st.pop();
        }

        sort(temp.begin(), temp.end());

        vector<int> ans;
        for (auto &p : temp) {
            ans.push_back(p.second);
        }

        return ans;
    }
};
