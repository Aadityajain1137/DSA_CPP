class Solution {
public:
    int solve(string& s1, string& s2, int i, int j, vector<vector<int>>& dp) {
        int n = s1.length();
        int m = s2.length();
        if (i == n && j == m) {
            return 0;
        }
        if (i == n) {
            int sum = 0;
            for (int k = j; k < m; k++) {
                sum += int(s2[k]);
            }
            return sum;
        }
        if (j == m) {
            int sum = 0;
            for (int k = i; k < n; k++) {
                sum += int(s1[k]);
            }
            return sum;
        }
           if (dp[i][j] != -1) {
            return dp[i][j];
        }
        if (s1[i] == s2[j])
            return dp[i][j] = solve(s1, s2, i + 1, j + 1, dp);
        return dp[i][j] = min(s1[i] + solve(s1, s2, i + 1, j, dp),
                              s2[j] + solve(s1, s2, i, j + 1, dp));
    }

    int minimumDeleteSum(string s1, string s2) {
        vector<vector<int>> dp(s1.length() + 1,
                               vector<int>(s2.length() + 1, -1));
        return solve(s1, s2, 0, 0, dp);
    }
};
