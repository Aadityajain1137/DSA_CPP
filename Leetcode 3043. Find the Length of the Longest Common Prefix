        unordered_set<string> st;
        int ans = 0;
        for(int x : arr1){
            string s = to_string(x);
            string temp = "";
            for(char c : s){
                temp+=c;
                st.insert(temp);
            }
        }
        for(int y : arr2){
            string s = to_string(y);
            string temp = "";
            for(char c : s){
                temp+=c;
                if(st.count(temp)){
                    ans = max(ans , (int)temp.size());
                }
            }
        }
        return ans;
    }
