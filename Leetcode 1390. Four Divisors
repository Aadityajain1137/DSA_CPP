class Solution {
public:
    void getDivisorSum(int n, int& sum) {
        vector<int> divisor;
        for (int i = 1; i * i <= n; i++) {
            if (n % i == 0) {
                divisor.push_back(i);
                if (i != n / i) {
                    divisor.push_back(n / i);
                }
            }
        }
        if (divisor.size() == 4) {
            for (int i = 0; i < divisor.size(); i++) {
                sum += divisor[i];
            }
        }
    }
    int sumFourDivisors(vector<int>& nums) {
        int sum = 0;
        for (int i = 0; i < nums.size(); i++) {
            getDivisorSum(nums[i], sum);
        }
        return sum;
    }
};
