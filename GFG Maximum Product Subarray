class Solution {
  public:
    int maxProduct(vector<int> &arr) {
        // code here
        int maxPro = arr[0];
        int minPro = arr[0];
        int ans = arr[0];
        for(int i=1;i<arr.size();i++){
            if(arr[i]<0){
                swap(maxPro , minPro);
            }
            maxPro = max(arr[i] , arr[i] * maxPro);
            minPro = min(arr[i] , arr[i] * minPro);
            ans = max(ans , maxPro);
        }
        return ans;
    }
};
