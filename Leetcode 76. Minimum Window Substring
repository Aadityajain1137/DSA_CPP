class Solution {
public:
    string minWindow(string s, string t) {
        vector<int>hash(256,0); 
        for(char c : t){
            hash[c]++;
        }
        int l =0;
        int r = 0;
        int minIdx = INT_MAX;
        int sIdx = -1;
        int cnt =0;
        int n = s.length();
        int m = t.length();
        while(r<n){
            hash[s[r]]--;
            if(hash[s[r]]>=0){
                cnt++;
            }
            while(cnt == m){
                if(r-l+1<minIdx){
                    minIdx = r-l+1;
                    sIdx = l;
                }
                hash[s[l]]++;
                if(hash[s[l]]>0) cnt--;
                l++;
            }
            r++;
        }   
        return sIdx ==-1 ? "" : s.substr(sIdx,minIdx);
    }
};
