    int levels(TreeNode* root){
        if(root == NULL) return 0;
        return 1 + max(levels(root->left ), levels(root->right));
    }
    void levelorder(TreeNode* root , int curr , int l,vector<int>&ans){
        if(root == NULL) return;
        if(curr == l){
            ans.push_back(root->val);
            return;
        }
        levelorder(root->left , curr+ 1, l,ans);
        levelorder(root->right , curr+1 , l,ans);
    }
    vector<vector<int>> level(TreeNode* root){
        int n = levels(root);
        vector<vector<int>> ans2;
        for(int i=1;i<=n;i++){
            vector<int> ans;
            levelorder(root , 1 , i , ans);
            ans2.push_back(ans);
        }
        return ans2;
    }
    vector<vector<int>> levelOrder(TreeNode* root) {
        // vector<vector<int>> result;
        // solve(root, result);
        return level(root);
    }
