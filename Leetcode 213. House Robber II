    int solve(vector<int> &nums){
        int n = nums.size();
        int prev2 = 0;
        int prev1 = nums[0];
        for(int i =1;i<n;i++){
            int include = prev2+nums[i];
            int exclude = prev1+0;
            int ans = max(include,exclude);
            prev2 = prev1;
            prev1= ans;
        }
        return prev1;
    }
