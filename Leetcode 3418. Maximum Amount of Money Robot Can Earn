class Solution {
public:
int n , m;
vector<vector<vector<int>>> dp;
    int solve(int i , int j , int k , vector<vector<int>>&coins){
        if(i>=n || j>=m) return -1e9;
        if(i == n-1 && j == m-1){
            if(coins[i][j]<0 && k>0){
                return 0;
            }
            return coins[i][j];
        }
        if(dp[i][j][k] != INT_MIN){
            return dp[i][j][k];
        }
        int right = solve(i ,j+1 , k , coins);
        int down = solve(i+1 , j ,k , coins);
        int ans = coins[i][j] + max(right , down);

        if(coins[i][j]<0 && k>0){
            int right1 = solve(i , j+1 , k-1 , coins);
            int down1 = solve(i+1 , j , k-1 , coins);
            ans=max(ans , max(right1 , down1));
        }
        return dp[i][j][k] = ans;
    }
    int maximumAmount(vector<vector<int>>& coins) {
        n = coins.size();
        m = coins[0].size();
        dp.assign(n, vector<vector<int>>(m, vector<int>(3, INT_MIN)));
        return solve(0,0,2,coins);
    }
};
