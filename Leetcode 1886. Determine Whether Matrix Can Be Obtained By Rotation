class Solution {
public:
    vector<vector<int>> rotate(vector<vector<int>>& mat){
        int n = mat.size();
        int m = mat[0].size();
        vector<vector<int>> ro(n , vector<int>(m ,0));
        for(int i=0;i<n;i++){
            for(int j =0;j<m;j++){
                ro[j][n-1-i] = mat[i][j];
            }
        }
        return ro;
    }
    bool findRotation(vector<vector<int>>& mat, vector<vector<int>>& target) {
        for(int i=0;i<4;i++){
            if(mat == target) return true;
            mat = rotate(mat);
        }
        return false;
    }
};
