class Solution {
  public:
    vector<int> topView(Node *root) {
        vector<int> ans;
        map<int , int > mp;
        queue<pair<Node* , int>> q;
        q.push({root , 0});
        
        while(!q.empty()){
            auto x = q.front();
            q.pop();
            Node* node = x.first;
            int level = x.second;
            if(mp.find(level) == mp.end()) mp[level] = node->data;
            if(node->left != NULL) q.push({node->left , level-1});
            if(node->right != NULL) q.push({node->right , level+1});
        }
        for(auto x : mp){
            ans.push_back(x.second);
        }
        return ans;
    }
};
